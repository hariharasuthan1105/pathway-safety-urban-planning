# ==============================================================================
# Public Safety & Urban Planning Platform - Environment Configuration
# ==============================================================================
# Copy this file to '.env' before running:
#   cp .env.example .env
#
# IMPORTANT: DO NOT commit your real '.env' file containing actual API keys!
# ==============================================================================

# System Data Mode: 'live', 'hybrid', or 'simulation'
DATA_MODE=hybrid

# Application Mode: 'public_safety' or 'urban_planning'
SYSTEM_MODE=public_safety

# System Location Coordinates (e.g. NYC Center)
LOCATION_LAT=40.7128
LOCATION_LON=-74.0060

# Port Configurations
DASHBOARD_PORT=8501
WEBHOOK_PORT=8000

# LLM & RAG Configuration (Required for real-time OpenAI query synthesis)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.3

# Optional Third-Party Connector Credentials
TWITTER_API_KEY=your_twitter_api_key_here
TRANSIT_API_KEY=your_transit_api_key_here
TRAFFIC_API_KEY=your_traffic_api_key_here
