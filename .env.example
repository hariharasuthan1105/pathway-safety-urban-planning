DATA_MODE=hybrid
ENVIRONMENT=development
AUTH_DB_PATH=./auth_store.db
WEBHOOK_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional: only the backend reads this. Blank enables deterministic fallback.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
TRAFFIC_SIM_SEED=42
# Optional external connector configuration depends on config/*.yaml.
GTFS_FEED_URL=
SOURCE_STALE_SECONDS=600
# Required secret for production webhook ingestion; leave out of Git.
WEBHOOK_SECRET=
WEBHOOK_RATE_LIMIT_RPM=120
MAX_WEBHOOK_PAYLOAD_BYTES=65536
# Exact trusted proxy addresses only; do not trust arbitrary forwarded headers.
TRUSTED_PROXIES=
